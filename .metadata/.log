 * arquivo de origem. Contendo apenas o nome e o valor total para aquele item.*/

package application;

import java.io.File;
import java

public class Program {

	public static void main(String[] args) {

		String strPath = Scanner sc = new Scanner(System.in);

		File path = new File(strPath);

		// Exibindo os arquivos presentes em um diretótio.
		File[] files = path.listFiles(File::isFile); // Cria um vetor do tipo File, contendo o caminho de cada um dos arquivos.

		System.out.println("Files:");
		for (File file : files) {
			System.out.println(file);
		}
		
