		for(File file : files) {
			System.out.println(file);
		}
		
		// Criando uma pasta dentro de um diretório.
		boolean success = new File(strPath + "//new-folder").mkdir();
		System.out.println("Diretório criado com sucesso: " + );
		
		sc.close();
	}

}

